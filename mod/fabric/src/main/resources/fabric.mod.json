{
  "schemaVersion": 1,
  "id": "campfire",
  "version": "${version}",
  "name": "Campfire",
  "description": "Peer-to-peer world hosting and social mod.",
  "authors": ["wayback09"],
  "license": "GPL-3.0",
  "icon": "assets/campfire/icon.png",

  "contact": {
    "homepage": "https://github.com/wayback09/Campfire",
    "sources": "https://github.com/wayback09/Campfire",
    "issues": "https://github.com/wayback09/Campfire/issues"
  },

  "environment": "client",
  "entrypoints": {
    "client": ["com.wayback09.campfire.fabric.CampfireFabric"],
    "modmenu": ["com.wayback09.campfire.fabric.CampfireModMenu"]
  },
  "mixins": [
    {
      "config": "campfire.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "yet_another_config_lib_v3": ">=3.8.0"
  },
  "recommends": {
    "modmenu": "*"
  }
}
